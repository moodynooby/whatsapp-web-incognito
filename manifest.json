{
  "manifest_version": 3,
  "name": "WAIncognito - Incognito for WhatsApp™",
  "short_name": "WAIncognito",
  "description": "Be invisible on WhatsApp™ Web by controlling read receipts and presence updates",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ua",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "128": "images/icon_128_blue.png"
  },
  "action": {
    "default_icon": "images/icon_128_reshaped.png",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "waincognito@wa-incognito.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": [
      "shared/jid_utils.js",
      "shared/settings_schema.js",
      "background.js"
    ]
  },
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared/bundle_manifest.js",
        "core_injection.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "shared/jid_utils.js",
        "shared/ephemeral_utils.js",
        "shared/settings_schema.js",
        "shared/settings_renderer.js",
        "shared/wai_page_bus.js",
        "core/ui_class_names.js",
        "core/ui.js",
        "lib/sweetalert.min.js",
        "core/status_download.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/*",
        "lib/*",
        "core/*",
        "images/*"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}